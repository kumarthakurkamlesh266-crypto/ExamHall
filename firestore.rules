rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Check if user is a teacher from users collection
    function isTeacher() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Single users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && incoming().uid == request.auth.uid;
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && incoming().uid == existing().uid;
    }

    // Tests
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() && isValidId(testId) && incoming().teacherId == request.auth.uid;
      allow update: if isTeacher() && existing().teacherId == request.auth.uid && incoming().teacherId == existing().teacherId;
      allow delete: if isTeacher() && existing().teacherId == request.auth.uid;
    }

    // Questions
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() && isValidId(questionId) && incoming().teacherId == request.auth.uid;
      allow update: if isTeacher() && existing().teacherId == request.auth.uid && incoming().teacherId == existing().teacherId;
      allow delete: if isTeacher() && existing().teacherId == request.auth.uid;
    }

    // Results
    match /results/{resultId} {
      allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.teacherId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(resultId) && incoming().studentId == request.auth.uid;
      allow update: if isSignedIn() && (existing().studentId == request.auth.uid || existing().teacherId == request.auth.uid);
    }
  }
}
